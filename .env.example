# Copy to .env.local for this machine, or set these in the host's
# environment variables for a deploy. Next reads .env.local automatically.

# /register: the sign-up (true) or the coming-soon page (false).
# Unset means open. The value is read where the pages are built, so changing
# it needs a new build — on Vercel, a redeploy.
BOO_REGISTRATION_OPEN=true
