# Copy to .env.local for this machine, or set these in the host's
# environment variables for a deploy. Next reads .env.local automatically.

# The whole site: the full site (true) or the coming-soon teaser (false).
# Unset means the teaser, so a forgotten variable never publishes the date.
# Read where the site is built: changing it needs a new build (a redeploy).
LIVE_STATUS=false

# Where registering happens: the outside page it runs on (a form, an event
# platform) — the site has no sign-up of its own. Once LIVE_STATUS is true,
# boo26.live/register, and so every Register button, redirects here. Unset:
# /register says registration isn't open yet. Read where the site is built,
# so changing it needs a new build — on Vercel, a redeploy.
REGISTER_URL=

# The team section on the full site: 0 hides it (and the menu and the
# section numbers close up round it), 1 shows the core team, 2 the core team
# and then the crew (CREW in src/lib/site.ts — until the crew's in there, 2
# shows the same as 1). Unset means 1. Read where the site is built.
TEAM_SECTION=1

# Where the site's own sign-up kept teams (db/schema.sql) — switched off now
# that registration is external, but the dashboard still reads them. Both
# come from the Supabase project's
# API settings. Without them the site keeps teams in its own memory, which is
# fine on one machine and loses them on a host that runs several.
#
# The service role key goes past row level security: server-side only, never
# NEXT_PUBLIC_, and not in the repo — .env.local is ignored by git.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# /admin: the core team's dashboard. Sign-in is Google, and only the emails
# listed here get in — see README → Registration → The dashboard.
#
# The client ID and secret come from a Google Cloud OAuth client (Web
# application) whose authorised redirect URIs include
# https://<the site>/admin/callback and http://localhost:3000/admin/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who's allowed in, comma separated. Taking an email off this list locks that
# account out on its next request, signed in or not.
ADMIN_EMAILS=someone@example.com, someone.else@example.com

# Signs the cookie that keeps an admin signed in. Any long random string:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Optional: Google Search Console's HTML-tag verification for boo26.live —
# just the content="…" value of the meta tag it gives you. (Verifying the
# domain with a DNS TXT record instead needs nothing here.)
GOOGLE_SITE_VERIFICATION=
